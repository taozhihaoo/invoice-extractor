# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Leave OPENAI_API_KEY empty to run fully offline in mock mode.

# mock | openai | auto (auto uses OpenAI only when a key is present)
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

DATABASE_PATH=data/processor.db
UPLOAD_DIR=data/uploads
EXPORT_DIR=output

MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=50
MAX_BATCH_FILES=20
MIN_NATIVE_TEXT_CHARS=100

APP_HOST=127.0.0.1
APP_PORT=8000
